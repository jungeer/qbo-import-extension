{
  "manifest_version": 3,
  "name": "QBO 批量导入助手",
  "version": "0.1.1",
  "description": "在 QuickBooks Online 页面右侧打开操作区，批量选择本地文件并逐个导入、保存。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "打开 QBO 导入助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/panel.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
